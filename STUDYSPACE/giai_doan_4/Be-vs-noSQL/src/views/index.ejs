<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NODE JS BASIC</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <div class="topnav">
        <a class="active" href="#home">Home</a>
        <a href="#news">News</a>
        <a href="#contact">Contact</a>
        <a href="#about">About</a>
    </div>

    <div>
        <h2>List users:</h2>
        <table>
            <thead>
                <tr>
                    <th>Id</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Actions</th>

                </tr>
            </thead>
            <tbody>
                <% for(let i=0 ; i< dataUser.length; i++) { %>
                    <tr>
                        <td>
                            <%= dataUser[i].id %>
                        </td>
                        <td>
                            <%= dataUser[i].firstName %>
                        </td>
                        <td>
                            <%= dataUser[i].lastName %>
                        </td>
                        <td>
                            <button><a href="/detail/user/<%= dataUser[i].id %>" /a>Detail</a></button>
                            <button><a href="/edit/user/<%= dataUser[i].id %>">Edit</a></button>
                            <button><a href="/delete/user/<%= dataUser[i].id %>">Delete</a></button>
                        </td>
                    </tr>
                    <% } %>
            </tbody>
        </table>
    </div>
    <div class="create-user-container">
        <div>Create user</div>

        <div class="fields">
            <form action="/create-new-user" , method="POST">
                <label for="fname">First name:</label>
                <input type="text" id="fname" name="firstName" value="">

                <label for="lname">Last name:</label>
                <input type="text" id="lname" name="lastName" value="">

                <label for="email">Email:</label>
                <input type="email" id="email" name="email" value="">

                <label for="address">Address:</label>
                <input type="text" id="address" name="address" value="">

                <button class="btn" type="submit">Create</button>
            </form>

        </div>
    </div>


</body>

</html>